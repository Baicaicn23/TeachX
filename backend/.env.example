# 默认使用本地 Mock 模型和哈希向量，不需要 API Key。
TEACHX_LLM_PROVIDER=mock
TEACHX_EMBEDDING_PROVIDER=mock

# 使用 OpenAI 兼容服务时取消下面的注释。
# TEACHX_LLM_PROVIDER=openai
# TEACHX_MODEL=gpt-4.1-mini
# TEACHX_EMBEDDING_PROVIDER=openai
# TEACHX_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

TEACHX_DATABASE_PATH=data/teachx.db
TEACHX_KNOWLEDGE_ROOT=data/knowledge
TEACHX_MAX_UPLOAD_BYTES=20971520
TEACHX_MAX_AGENT_ROUNDS=6
# 输出 token 上限。推理型模型(如 DeepSeek R 系)会把预算花在思考内容上,
# 默认 1024 可能截断到"没有可见回答";使用推理模型时建议提高到 4096。
TEACHX_MAX_OUTPUT_TOKENS=1024
TEACHX_MAX_HISTORY_MESSAGES=24
TEACHX_MAX_HISTORY_CHARS=16000
TEACHX_MAX_TOOL_RESULT_CHARS=6000
TEACHX_TOOL_MAX_ATTEMPTS=3
TEACHX_TOOL_TIMEOUT_SECONDS=30
TEACHX_TOOL_RETRY_BASE_DELAY_MS=200
TEACHX_TOOL_RETRY_MAX_DELAY_MS=2000

# 默认使用本地截断标题。开启后会额外调用一次模型生成会话标题。
TEACHX_GENERATE_TITLES=false
# 请求 OpenAI 兼容流返回 usage；供应商不支持时会自动回退并估算用量。
TEACHX_INCLUDE_STREAM_USAGE=true

# P0 意图识别与多 Agent 路由。关闭 intent_enabled 即回到无路由行为;
# 关闭 intent_llm_enabled 后只走规则分类,零 API 消耗。
TEACHX_INTENT_ENABLED=true
TEACHX_INTENT_LLM_ENABLED=true

# P3 跨会话长期记忆:规则抽取("记住：..."/自我陈述)写入 user_memories,
# 下会话注入系统提示词(与个性化开关共用数据边界)。
TEACHX_MEMORY_ENABLED=true

# 0 表示不限制。超限时可选择 block（阻止真实调用）或 mock（回退本地 Mock）。
TEACHX_DAILY_TOKEN_BUDGET=0
TEACHX_BUDGET_EXCEEDED_ACTION=block

# 单用户本地开发保持 false；部署到公网时改为 true。
TEACHX_AUTH_ENABLED=false
TEACHX_AUTH_SECRET=replace-with-at-least-32-random-bytes
TEACHX_AUTH_COOKIE_SECURE=false
TEACHX_AUTH_TOKEN_TTL_MINUTES=1440
